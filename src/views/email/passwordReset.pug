extends baseEmail

block content
  p Hi #{firstName},

  p
    | We received a request to reset your Sapori password.

  p
    | Click the button below to choose a new password.
    | This link is valid for 10 minutes.

  table.btn.btn-primary(
    role='presentation'
    border='0'
    cellpadding='0'
    cellspacing='0'
  )
    tbody
      tr
        td(align='left')
          table(
            role='presentation'
            border='0'
            cellpadding='0'
            cellspacing='0'
          )
            tbody
              tr
                td
                  a(
                    href=url
                    target='_blank'
                    rel='noopener noreferrer'
                  )
                    | Reset your password

  p
    | If the button does not work, copy and paste this link into your browser:

  p
    a(
      href=url
      target='_blank'
      rel='noopener noreferrer'
    )= url

  p
    | If you didn't request a password reset, you can safely ignore this email.